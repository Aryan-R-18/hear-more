{
  "manifest_version": 3,
  "name": "Kinetic Lyrics",
  "version": "0.1.0",
  "description": "Real-time kinetic typography lyrics visualizer for YouTube, YouTube Music, and Spotify Web",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://music.youtube.com/*",
    "*://open.spotify.com/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://music.youtube.com/*",
        "*://open.spotify.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Kinetic Lyrics",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html",
        "sidepanel.html",
        "assets/*",
        "icons/*"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://music.youtube.com/*",
        "*://open.spotify.com/*"
      ]
    }
  ]
}

